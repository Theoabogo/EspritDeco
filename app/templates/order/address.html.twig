{% extends 'base.html.twig' %}

{% block title %}Adresse de livraison — Esprit Déco{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <h2 class="mb-4">Adresse de livraison</h2>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}

        <div class="mb-3">
            {{ form_label(form.fullname, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.fullname, {'attr': {'class': 'form-control' ~ (form.fullname.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.fullname) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.street, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.street, {'attr': {'class': 'form-control' ~ (form.street.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.street) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.zipCode, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.zipCode, {'attr': {'class': 'form-control' ~ (form.zipCode.vars.errors|length ? ' is-invalid' : ''), 'maxlength': 5}}) }}
            {{ form_errors(form.zipCode) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.city, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.city, {'attr': {'class': 'form-control' ~ (form.city.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.city) }}
        </div>

        <div class="d-flex justify-content-between mt-2">
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                &larr; Retour au catalogue
            </a>
            <button type="submit" class="btn btn-primary">
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
