{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de la commande — Esprit Déco{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        <h2 class="mb-4">Récapitulatif de votre commande</h2>

        {# Adresse de livraison #}
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Adresse de livraison</span>
                <a href="{{ path('order_address') }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
            </div>
            <div class="card-body">
                <p class="mb-1">{{ order.address.fullname }}</p>
                <p class="mb-1">{{ order.address.street }}</p>
                <p class="mb-0">{{ order.address.zipCode }} {{ order.address.city }}</p>
            </div>
        </div>

        {# Articles du panier #}
        <div class="card mb-4">
            <div class="card-header fw-semibold">Articles</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Qté</th>
                            <th class="text-end">Prix unit.</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                        <tr>
                            <td>{{ item.product.title }}</td>
                            <td class="text-center">{{ item.quantity }}</td>
                            <td class="text-end">{{ item.product.price|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end">{{ (item.product.price * item.quantity)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">Votre panier est vide.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    {% if items|length > 0 %}
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end">{{ total|number_format(2, ',', ' ') }} €</th>
                        </tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>
        </div>

        {# Boutons #}
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('order_address') }}" class="btn btn-outline-secondary">
                &larr; Modifier l'adresse
            </a>

            <form method="post" action="{{ path('order_confirm', {id: order.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('order_confirm_' ~ order.id) }}">
                <button type="submit" class="btn btn-success btn-lg" {% if items|length == 0 %}disabled{% endif %}>
                    Confirmer ma commande
                </button>
            </form>
        </div>

    </div>
</div>
{% endblock %}
