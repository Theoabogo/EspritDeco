{% extends 'base.html.twig' %}

{% block title %}Commande confirmée — Esprit Déco{% endblock %}

{% block body %}
<div class="row justify-content-center text-center">
    <div class="col-12 col-md-6">
        <div class="alert alert-success mt-4">
            <h4 class="alert-heading">Commande enregistrée !</h4>
            <p>Merci pour votre commande n°{{ order.id }}.</p>
        </div>

        <div class="card mb-4">
            <div class="card-body text-start">
                <h5 class="card-title">Récapitulatif</h5>
                <ul class="list-unstyled mb-0">
                    <li><strong>Nom et Prénom :</strong> {{ order.address.fullname }}</li>
                    <li><strong>Adresse :</strong> {{ order.address.street }}</li>
                    <li><strong>Code postal :</strong> {{ order.address.zipCode }}</li>
                    <li><strong>Ville :</strong> {{ order.address.city }}</li>
                    <li class="mt-2"><strong>Statut :</strong> {{ order.status }}</li>
                    <li><strong>Date :</strong> {{ order.createdAt|date('d/m/Y à H:i') }}</li>
                </ul>
            </div>
        </div>

        <a href="{{ path('app_home') }}" class="btn btn-primary">
            Retour au catalogue
        </a>
    </div>
</div>
{% endblock %}
