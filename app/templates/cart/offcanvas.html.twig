<div
    class="offcanvas offcanvas-end text-bg-dark"
    tabindex="-1"
    id="cartOffcanvas"
>

    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">
            Mon panier
        </h5>

        <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas">
        </button>
    </div>

    <div class="offcanvas-body" id="cartOffcanvasBody">

        {% if cartItems is empty %}

            <p>Votre panier est vide.</p>

        {% else %}

            {% set total = 0 %}

            <table class="table table-dark align-middle">

                {% for item in cartItems %}

                    {% set total = total + (item.product.price * item.quantity) %}

                    <tr>
                        <td>{{ item.product.title }}</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-secondary cart-btn cart-decrease" data-id="{{ item.product.id }}">−</button>
                            <span class="mx-1">{{ item.quantity }}</span>
                            <button class="btn btn-sm btn-secondary cart-btn cart-add" data-id="{{ item.product.id }}">+</button>
                        </td>
                        <td class="text-nowrap">{{ (item.product.price * item.quantity)|number_format(2, '.', ' ') }} €</td>
                        <td>
                            <button class="btn btn-sm btn-danger cart-btn cart-remove" data-id="{{ item.product.id }}">🗑️</button>
                        </td>
                    </tr>

                {% endfor %}

                <tr>
                    <td colspan="2"><strong>Total</strong></td>
                    <td colspan="2"><strong>{{ total|number_format(2, '.', ' ') }} €</strong></td>
                </tr>

            </table>

            <button class="btn btn-danger w-100 mb-2" id="cart-clear">
                🗑️ Vider le panier
            </button>

            <a href="{{ path('order_address') }}" class="btn btn-success w-100">
                💳 Payer
            </a>

        {% endif %}

    </div>

</div>
