<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Esprit Déco{% endblock %}</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/superhero/bootstrap.min.css">
        <link rel="stylesheet" href="{{ asset('css/header.css') }}">
        <link rel="stylesheet" href="{{ asset('css/general.css') }}">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% include '_shared/_header.html.twig' %}
        {% include '_shared/_nav.html.twig' %}
        <main class="container py-5 flex-grow-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="bg-light text-dark mt-auto py-4">
    <div class="container">
        <div class="row text-center align-items-center">
            <div class="col-12 col-md-4 mb-3 mb-md-0">
                <a href="#" class="text-decoration-none text-dark"> Consulter les CGV</a>
            </div>
            <div class="col-12 col-md-4 mb-3 mb-md-0">
                <img src="{{ asset('images/logo.webp') }}" alt="Esprit Déco" height="40">
            </div>
            <div class="col-12 col-md-4">
                <p class="mb-0">© {{ "now"|date("Y") }} Esprit Déco</p>
            </div>

        </div>
    </div>
</footer>

    </body>
</html>
