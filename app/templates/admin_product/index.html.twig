{% extends 'base.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block body %}
<div>
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}">
            {{ message }}
{% endfor %}
{% endfor %}
</div>
<h1 class="text-center mb-5">Gestion des produits</h1>
<div class="text-center my-4">
    <a href="{{path('admin_product_add')}}" class="text-decoration-none fs-3">✚</a>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Prix</th>
            <th>Catégorie</th>
            <th>Modifier</th>
            <th>Supprimer</th>
        </tr>
    </thead>
     <tbody>
    {% for product in products %}
        <tr>
            <td>
                <a href="{{ path('app_admin_product_list') }}" class="text-decoration-none">
                    {{ product.title }}
                </a>
            </td>
            <td>{{ product.price }} €</td>
            <td>
                {{ product.category ? product.category.name : 'Aucune catégorie' }}
            </td>

            <td>
               <a href="{{path('admin_product_add')}}" class="text-decoration-none">✏️</a>
            </td>
            <td>
                <a href="{{ path('admin_product_delete', {'id': product.id}) }}" class = "text-decoration-none" onclick = "return confirm('Etes-vous sur de vouloir supprimer ce produit ?')">
                    ❌
                </a>
            </td>
        </tr>

    {% endfor %}
    </tbody>
</table>
<a href="{{ path('admin_product_index') }}" class="btn btn-danger">
    Retour
</a>
{% endblock %}
